{
  "name": "imula-flow",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "pnpm --filter @imula/web dev",
    "build": "pnpm --filter @imula/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "worker:documents": "pnpm --filter @imula/web worker:documents",
    "db:check": "scripts/check-migrations.sh",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts",
    "powersync:up": "docker compose -f infra/powersync/docker-compose.yaml up -d",
    "powersync:down": "docker compose -f infra/powersync/docker-compose.yaml down",
    "mobile": "pnpm --filter @imula/mobile start"
  }
}
