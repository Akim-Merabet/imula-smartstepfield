# Copier en .env.local (non versionné). Sur un appareil Android physique, remplacer 127.0.0.1
# par l'adresse IP de la machine de développement (ou utiliser `adb reverse tcp:55921 tcp:55921`).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55921
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POWERSYNC_URL=http://127.0.0.1:55930
