# Copier en .env (ignoré par git).
PS_PORT=55930
PS_IMAGE_TAG=latest
# Base applicative Supabase vue depuis le réseau docker (rôle avec REPLICATION ; en production un rôle dédié BYPASSRLS + REPLICATION).
PS_DATA_SOURCE_URI=postgres://postgres:postgres@supabase_db_siteflow:5432/postgres
# Clés publiques Supabase Auth (JWT ES256) via Kong.
PS_JWKS_URI=http://supabase_kong_siteflow:8000/auth/v1/.well-known/jwks.json
PS_STORAGE_PASSWORD=change-me-storage
# Jeton de l'API d'administration PowerSync (diagnostic).
PS_API_TOKEN=change-me-admin-token
